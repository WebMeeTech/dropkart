{% extends 'node--teaser.html.twig' %}

{% set teaser_classes = [
  'teaser--compact',
  'teaser--small-compact'
] %}

{% set attributes = attributes.addClass(teaser_classes) %}

{% block teaser_content %}
<div class="teaser--media">
  {{ product.field_product_images }}
  <div class="channel teaser__channel">
    <h2 class="teaser__headline">
    {{ product.title }}
    </h2>
  </div>
</div>
{% endblock %}
