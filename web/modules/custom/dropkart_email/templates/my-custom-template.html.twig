{# themes/custom/my_custom_theme/templates/my-custom-template.html.twig #}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Order Confirmation - {{ site_name }}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #333;
      line-height: 1.6;
    }
    .container {
      width: 80%;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      background-color: #f9f9f9;
    }
    .header {
      text-align: center;
      padding: 10px 0;
    }
    .header img {
      max-width: 150px;
    }
    .content {
      margin-top: 20px;
    }
    .content h2 {
      color: #007bff;
    }
    .content p {
      margin: 10px 0;
    }
    .order-details {
      margin: 20px 0;
      border-collapse: collapse;
      width: 100%;
    }
    .order-details th, .order-details td {
      padding: 10px;
      border: 1px solid #e0e0e0;
    }
    .order-details th {
      background-color: #f0f0f0;
    }
    .footer {
      text-align: center;
      padding: 10px 0;
      margin-top: 20px;
      border-top: 1px solid #e0e0e0;
    }
    .footer p {
      margin: 5px 0;
    }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <img src="{{ file_url('public://images/shopping-online-1024x724.jpg') }} }}" alt="{{ site_name }} Logo">
  </div>
  <div class="content">
    <h2>Order Confirmation</h2>
    <p>Dear {{ customer_profile }},</p>
    <p>Thank you for your order! Your order number is <strong>{{ order_nu }}</strong>.</p>

    <h3>Order Details</h3>
    <table class="order-details">
      <thead>
      <tr>
        <th>Item</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
      </tr>
      </thead>
      <tbody>
{#      {% for item in order_items %}#}
        <tr>
          <td>{{ item_text }}</td>
          <td>{{ quantity }}</td>
          <td>{{ unit_price }}</td>
          <td>{{ total }}</td>
        </tr>
{#      {% endfor %}#}
      </tbody>
      <tfoot>
      <tr>
        <th colspan="3" style="text-align: right;">Subtotal</th>
        <td>{{ subtotal }}</td>
      </tr>
      <tr>
        <th colspan="3" style="text-align: right;">Total</th>
        <td><strong>{{ total }}</strong></td>
      </tr>
      </tfoot>
    </table>

{#    <h3>Shipping Address</h3>#}
{#    <p>{{ shipping_address|nl2br }}</p>#}
    {{ dump() }}
    <h3>Billing Address</h3>
    <p>{{ billing_address|nl2br }}</p>
  </div>
  <div class="footer">
    <p>Thank you for shopping with {{ site_name }}!</p>
    <p><a href="{{ site_url }}">Visit our website</a></p>
  </div>
</div>
</body>
</html>

